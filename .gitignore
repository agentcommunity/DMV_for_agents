.DS_Store
.env
.npmrc
node_modules/
supabase/.temp/

# Git worktrees — local-only, should never be tracked or packaged
# (npm publish from repo root would otherwise walk into .worktrees/
#  and double-ship everything; root package.json "private": true is
#  the hard safety, this is belt-and-suspenders)
.worktrees/
.release-artifacts/

# Local tooling artifacts (generated)
.claude/
deno.lock

# Cloudflare migration build outputs
dist/
.wrangler/
test-harness/output/
worker/container-instance.ts
