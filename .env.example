# Supabase — only needed for edge function deployment, not for local frontend dev
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Shared Worker-to-Edge credential. Configure the same generated secret as an
# encrypted Cloudflare Worker secret and a Supabase project secret. Never put a
# live value in this file or expose it to browser, CLI, MCP, or API clients.
DMV_PROXY_SECRET=""

# Required Worker bindings are configured in wrangler.jsonc, not dotenv:
# - RL_CERT_LOOKUP: coarse 60 requests per 60 seconds per hashed IP
# - CERT_LOOKUP_LIMITER: exact SQLite DO 30 requests per 60 seconds per hashed IP
# - BADGE_CACHE_KV: lookup result cache (300s issued, 60s not found)
# - REGISTER_COOLDOWN_KV: registration fingerprint cooldowns only
