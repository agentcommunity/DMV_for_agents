# Cache + security headers for the DMV static assets, ported from vercel.json.
# Format: Cloudflare Workers Static Assets / Pages _headers spec.
# Path matches use exact / wildcard rules; later rules override earlier ones.

# ─── Security headers (apply to everything) ───
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin

# ─── Index — short cache, allow stale ───
/
  Cache-Control: public, max-age=0, s-maxage=60, stale-while-revalidate=300

/index.html
  Cache-Control: public, max-age=0, s-maxage=60, stale-while-revalidate=300

# ─── Immutable (1 year) ───
/models/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

# ─── Long-but-not-immutable ───
/audio/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800
