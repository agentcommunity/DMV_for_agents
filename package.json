{
  "private": true,
  "name": "dmv-agentcommunity",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "workspaces": [
    "packages/*"
  ],
  "description": "DMV on Cloudflare Workers Static Assets + Containers (Skia card renderer) + R2 read-through cache. Worker source lives in worker/, container in container/, shared SPA in js/ + css/ + index.html.",
  "scripts": {
    "dev": "node dev-server.mjs",
    "start": "node dev-server.mjs",
    "serve": "node dev-server.mjs",
    "build": "node scripts/build-root.mjs",
    "check": "node --test tests/text-surfaces.test.mjs",
    "test:worker": "node --import tsx --test tests/worker-*.test.ts",
    "test": "pnpm check && pnpm test:worker",
    "text:audit": "node scripts/text-surfaces/run-audit.mjs",
    "text:audit:json": "node scripts/text-surfaces/run-audit.mjs --json",
    "text:check": "node --test tests/text-surfaces.test.mjs",
    "cf:dev": "pnpm cf:build && wrangler dev",
    "cf:deploy": "pnpm cf:build && wrangler deploy",
    "cf:tail": "wrangler tail",
    "cf:test:render": "node test-harness/render-comparison.mjs",
    "cf:build": "node scripts/build-cf.mjs",
    "cf:container:build": "docker build -t dmv-card-renderer container/"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
