/**
 * Wrangler config for dmv.agentcommunity.org on Cloudflare.
 *
 * Pipeline:
 *   Worker (worker/index.ts) ─┬─ Workers Static Assets (dist/)
 *                             ├─ Container (Node 20 + @napi-rs/canvas)
 *                             ├─ R2 (L2 read-through card cache)
 *                             └─ caches.default (L1 edge cache, in front of R2)
 *
 * Local dev: `pnpm cf:dev`   (runs cf:build → wrangler dev)
 * Deploy:    `pnpm cf:deploy` (runs cf:build → wrangler deploy)
 *
 * See CLOUDFLARE.md for full architecture, cache hierarchy, and
 * build-time drift invariants enforced by scripts/build-cf.mjs.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dmv-agentcommunity",
	"main": "worker/index.ts",
	// Taqanu account — same as main agentcommunity_page worker.
	// Not a secret: the account ID is visible in any workers.dev subdomain
	// this account hosts and is committed to wrangler configs across the org.
	"account_id": "9a551fc3ff2c0e9ac70baa42a0138896",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": [
		"nodejs_compat"
	],

	// ──────────────────────────────────────────────────────────────────────────
	//  Static Assets — DMV SPA (index.html + js/ + css/ + fonts/ + audio/ + models/)
	// ──────────────────────────────────────────────────────────────────────────
	// `dist/` is populated by `pnpm cf:build` (scripts/build-cf.mjs) which copies
	// only the production-facing files from the repo root. Bandwidth on static
	// assets is FREE (no per-request cost), so the 2.2 MB GLB and 6 MB audio
	// directory cost nothing.
	//
	// `not_found_handling = single-page-application` means any request that
	// doesn't match a file gets index.html — required for /c/:certId/:agentName
	// permalinks to load the SPA.
	//
	// `run_worker_first` lists paths where the Worker runs BEFORE static assets.
	// We use this for /api/* (card + og), /c/* (crawler middleware via HTMLRewriter),
	// /badge + /badge/* (Supabase proxy), and /healthz. Everything else falls through to
	// static assets directly with no Worker invocation cost.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/c/*",
			"/badge",
			"/badge/*",
			"/healthz"
		]
	},
	// ──────────────────────────────────────────────────────────────────────────
	//  Container: Node 20 + @napi-rs/canvas card renderer
	// ──────────────────────────────────────────────────────────────────────────
	"containers": [
		{
			"class_name": "CardRenderer",
			"image": "./container/Dockerfile",
			// 1 active instance is enough: DMV expects a few thousand requests
			// over the Brave window (the main site at agentcommunity_page is
			// the 25M-impression hot path, not DMV). With R2 + L1 cache in
			// front, effective container time per request is near-zero after
			// the first render of each unique (name, type, format) combo.
			"max_instances": 1
			// instance_type omitted → defaults to "lite" (1/4 vCPU, 256 MiB).
			// Verified from CF Containers docs: valid types are "lite"
			// (default), "basic", "standard-1" through "standard-4". A
			// previous commit set this to "basic" in anticipation of takeover
			// load, but DMV doesn't see that traffic — reverted to avoid
			// paying for headroom we won't use.
		}
	],
	// Containers are exposed via Durable Object bindings.
	"durable_objects": {
		"bindings": [
			{
				"name": "CARD_RENDERER",
				"class_name": "CardRenderer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CardRenderer"
			]
		}
	],
	// ──────────────────────────────────────────────────────────────────────────
	//  R2: read-through cache for rendered cards
	// ──────────────────────────────────────────────────────────────────────────
	// The actual bucket is created with:
	//   pnpm wrangler r2 bucket create dmv-card-cache-test
	// For local dev, wrangler simulates R2 in .wrangler/state — no real bucket
	// is touched until you `wrangler deploy`.
	"r2_buckets": [
		{
			"binding": "CARD_CACHE",
			"bucket_name": "dmv-card-cache-test",
			"preview_bucket_name": "dmv-card-cache-test-preview"
		}
	],
	// ──────────────────────────────────────────────────────────────────────────
	//  KV: badge cache + local registration cooldown state
	// ──────────────────────────────────────────────────────────────────────────
	// BADGE_CACHE_KV stores badge responses and prefixed certificate lookup cache
	// entries.
	// REGISTER_COOLDOWN_KV stores registration cooldowns and prefixed lookup
	// counters. Kept LOCAL to DMV — not shared with PAGE.
	"kv_namespaces": [
		{
			"binding": "BADGE_CACHE_KV",
			"id": "af14d3897b7b4964a75d7f0bfeb84600",
			"preview_id": "52e93ba4257e4d2bbf671bdbaa5705be"
		},
		{
			"binding": "REGISTER_COOLDOWN_KV",
			"id": "ec0cdc55c2f94267af84f0218c961a00",
			"preview_id": "dc0c4a98b4764d448f35872de11984be"
		}
	],
	// ──────────────────────────────────────────────────────────────────────────
	//  Analytics Engine: structured metrics for cache tiers + container latency
	// ──────────────────────────────────────────────────────────────────────────
	// Free at DMV's volume. Replaces ad-hoc console.log observability with a
	// queryable dataset. Schema documented in worker/index.ts near the first
	// writeDataPoint call.
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "dmv_worker_events"
		}
	],
	// ──────────────────────────────────────────────────────────────────────────
	//  Workers Rate Limiting API: render-path protection + shared registration
	//  counters aligned with agentcommunity_PAGE
	// ──────────────────────────────────────────────────────────────────────────
	// API_RATE_LIMITER guards existing render routes /api/card and /api/og from
	// enumeration; its 100/minute budget is intentionally unchanged.
	// RL_CERT_LOOKUP guards only /api/lookup at 30/minute/IP.
	// RL_OTP_EMAIL + RL_OTP_IP_EMAIL share the exact Cloudflare namespace IDs
	// used by PAGE because those counters represent the same abuse surface on
	// both properties. DMV intentionally does NOT bind RL_AUTH or RL_OTP_IP from
	// PAGE — those stay property-local.
	//
	// NOTE: this is the stable top-level `ratelimits` array, not the old
	// `unsafe.bindings` form. Requires wrangler ≥ 4.36.0.
	// `period` MUST be 10 or 60 (seconds) — no other values are accepted.
	// Docs: https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	"ratelimits": [
		{
			"name": "API_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "RL_CERT_LOOKUP",
			"namespace_id": "1002",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "RL_OTP_EMAIL",
			"namespace_id": "4005",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RL_OTP_IP_EMAIL",
			"namespace_id": "4007",
			"simple": {
				"limit": 4,
				"period": 60
			}
		}
	],
	// ──────────────────────────────────────────────────────────────────────────
	//  Cron prewarm — keep the hot DMV URLs warm in L1/L2
	// ──────────────────────────────────────────────────────────────────────────
	// Hourly is plenty for DMV's expected traffic. L1 TTL is 7 days and the
	// main purpose is "first Brave hit is already cache-warm" — any schedule
	// shorter than a couple hours is overkill. CF rotates cron execution
	// across PoPs, so over the course of a day the cron touches a reasonable
	// spread of serving regions. See worker/index.ts `scheduled` handler and
	// the PREWARM_PATHS constant for the list of URLs warmed.
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		"PREWARM_ORIGIN": "https://dmv.agentcommunity.org"
	},
	// ──────────────────────────────────────────────────────────────────────────
	//  Observability — useful for debugging container cold starts during the bake-off
	// ──────────────────────────────────────────────────────────────────────────
	"observability": {
		"enabled": true
	}
}
