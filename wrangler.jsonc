/**
 * Wrangler config for the DMV cloudflare-migration branch.
 *
 * Pipeline:
 *   Worker (worker/index.ts) ─┬─ Workers Static Assets (dist/)
 *                             ├─ Container (Node 20 + @napi-rs/canvas)
 *                             └─ R2 (read-through card cache)
 *
 * NOT yet wired to dmv.agentcommunity.org — DNS cutover is the last step.
 *
 * Local dev: `pnpm cf:dev`
 * Deploy:    `pnpm cf:deploy` (runs cf:vendor → cf:build → wrangler deploy)
 *
 * See CLOUDFLARE.md for full architecture and rationale.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dmv-card-test",
	"main": "worker/index.ts",
	// Taqanu account — same as main agentcommunity_page worker.
	// Not a secret: the account ID is visible in any workers.dev subdomain
	// this account hosts and is committed to wrangler configs across the org.
	"account_id": "9a551fc3ff2c0e9ac70baa42a0138896",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": [
		"nodejs_compat"
	],

	// ──────────────────────────────────────────────────────────────────────────
	//  Static Assets — DMV SPA (index.html + js/ + css/ + fonts/ + audio/ + models/)
	// ──────────────────────────────────────────────────────────────────────────
	// `dist/` is populated by `pnpm cf:build` (scripts/build-cf.mjs) which copies
	// only the production-facing files from the repo root. Bandwidth on static
	// assets is FREE (no per-request cost), so the 2.2 MB GLB and 6 MB audio
	// directory cost nothing.
	//
	// `not_found_handling = single-page-application` means any request that
	// doesn't match a file gets index.html — required for /c/:certId/:agentName
	// permalinks to load the SPA.
	//
	// `run_worker_first` lists paths where the Worker runs BEFORE static assets.
	// We use this for /api/* (card + og), /c/* (crawler middleware via HTMLRewriter),
	// /badge/* (Supabase proxy), and /healthz. Everything else falls through to
	// static assets directly with no Worker invocation cost.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/c/*",
			"/badge/*",
			"/healthz"
		]
	},
	// ──────────────────────────────────────────────────────────────────────────
	//  Container: Node 20 + @napi-rs/canvas card renderer
	// ──────────────────────────────────────────────────────────────────────────
	"containers": [
		{
			"class_name": "CardRenderer",
			"image": "./container/Dockerfile",
			// 5 active instances. Combined with worker/index.ts POOL_SIZE=5
			// (pickContainer helper) this gives us a 5-slot version-namespaced
			// pool that random-distributes render load.
			"max_instances": 5,
			// "lite" (the default — verified from CF docs and the deploy diff)
			// is 1/4 vCPU and 256 MiB. "basic" is 1/2 vCPU and 1 GiB, which
			// gives the Skia renderer enough headroom for a thundering-herd
			// burst on the homepage og:image during the Brave new tab takeover
			// without the renderer choking on its own queue.
			"instance_type": "basic"
		}
	],
	// Containers are exposed via Durable Object bindings.
	"durable_objects": {
		"bindings": [
			{
				"name": "CARD_RENDERER",
				"class_name": "CardRenderer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CardRenderer"
			]
		}
	],
	// ──────────────────────────────────────────────────────────────────────────
	//  R2: read-through cache for rendered cards
	// ──────────────────────────────────────────────────────────────────────────
	// The actual bucket is created with:
	//   pnpm wrangler r2 bucket create dmv-card-cache-test
	// For local dev, wrangler simulates R2 in .wrangler/state — no real bucket
	// is touched until you `wrangler deploy`.
	"r2_buckets": [
		{
			"binding": "CARD_CACHE",
			"bucket_name": "dmv-card-cache-test",
			"preview_bucket_name": "dmv-card-cache-test-preview"
		}
	],
	// ──────────────────────────────────────────────────────────────────────────
	//  Cron prewarm — keep L1/L2 caches warm for the Brave new tab takeover
	// ──────────────────────────────────────────────────────────────────────────
	// Schedule: every 10 minutes, the Worker fetches PREWARM_PATHS through
	// PREWARM_ORIGIN. CF runs cron triggers from various PoPs over time so
	// this acts as a poor-man's global L1 warmer. After cutover, switch
	// PREWARM_ORIGIN to https://dmv.agentcommunity.org. See worker/index.ts
	// `scheduled` handler for the implementation and the PREWARM_PATHS list.
	"triggers": {
		"crons": ["*/10 * * * *"]
	},
	"vars": {
		"PREWARM_ORIGIN": "https://dmv-card-test.b-9a5.workers.dev"
	},
	// ──────────────────────────────────────────────────────────────────────────
	//  Observability — useful for debugging container cold starts during the bake-off
	// ──────────────────────────────────────────────────────────────────────────
	"observability": {
		"enabled": true
	}
}